{
  "name": "wattle-notes",
  "version": "0.1.11",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint . && tsc -b",
    "format": "prettier --write src tests scripts *.json *.ts *.js docs README.md CONTRIBUTING.md",
    "test": "vitest run && node --test tests/release.test.mjs tests/launch.test.mjs tests/updates.test.mjs tests/security.test.mjs",
    "check:security": "node scripts/check-security-baseline.mjs",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --locked",
    "test:desktop": "cargo test --manifest-path src-tauri/Cargo.toml --lib --locked",
    "check:core": "cargo clippy --manifest-path src-tauri/Cargo.toml --no-default-features --locked -- -D warnings",
    "check:desktop": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-release.mjs",
    "desktop:build:local": "tauri build",
    "desktop:release": "node scripts/build-release.mjs",
    "desktop:check-config": "node scripts/build-release.mjs --check-config",
    "desktop:verify-google": "node scripts/verify-google-build.mjs",
    "launch:prepare": "node scripts/prepare-launch.mjs",
    "launch:verify": "python3 scripts/verify-launch.py",
    "test:launch": "python3 -B -m unittest discover -s tests -p test_launch_verifier.py",
    "test:e2e": "playwright test",
    "notices": "node scripts/generate-notices.mjs",
    "updates:build": "node scripts/prepare-update.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@uiw/react-codemirror": "^4.25.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.7",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.53.0",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
