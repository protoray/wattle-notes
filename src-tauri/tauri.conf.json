{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wattle Notes",
  "version": "0.1.14",
  "identifier": "org.newnotes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wattle Notes",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your words, your files",
    "longDescription": "Offline Markdown notes with end-to-end encrypted Google Drive synchronization.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/dependency-licenses/": "licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2N0M3RUE4RUY5RjRFQjQKUldTMFRwL3ZxSDU4UnRyTkYvaHpyUitnbU5Wang0cjZ4aVkxWEFGSW1XdVhlSDNEYkxpM2ZKeFkK",
      "endpoints": [
        "https://raw.githubusercontent.com/protoray/wattle-notes/main/updates/alpha.json"
      ]
    }
  }
}
